# Docs Playground Environment Configuration Template

# Server Port & Environment
PORT=5005
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:3000
DATA_FILE=data_store.json
UPLOAD_DIR=uploads

# Encryption Secret Key (used to transparently decrypt encrypted keys if enc: prefix is used)
ENCRYPTION_SECRET=docs_playground_secure_master_key_2026

# OpenAI API Key (ChatGPT / GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI Studio API Key (Gemini 2.0 / 1.5)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_STUDIO_API_KEY=your_gemini_api_key_here

# DeepSeek API Key (DeepSeek R1)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Meta Llama 3 API Key
LLAMA_API_KEY=your_llama_api_key_here

# OCR Engine API Keys (OCR.space)
OCR_API_KEY=your_ocr_space_api_key_here
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
